# LF everywhere, so a checkout on Windows doesn't turn every line into a diff
# (and rustfmt sees the same bytes on every OS).
* text=auto eol=lf

# Hooks run under sh, which needs LF.
.githooks/* text eol=lf

# Saved Steam pages the parser is tested against: keep them byte for byte.
library/steam-api/tests/pages/* -text
